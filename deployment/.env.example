APP_URL=http://localhost:3000
DOCMOST_PORT=3000
APP_SECRET=replace_with_a_long_random_secret

POSTGRES_DB=docmost
POSTGRES_USER=docmost
POSTGRES_PASSWORD=replace_with_a_strong_db_password

SYNC_ENABLED=true
SYNC_INTERVAL_SECONDS=86400
SYNC_RETENTION_DAYS=7
SYNC_PASSPHRASE=replace_with_a_backup_encryption_passphrase
SYNC_RCLONE_REMOTE=oss:db
SYNC_STORAGE_ENABLED=true
SYNC_STORAGE_REMOTE=oss:storage
